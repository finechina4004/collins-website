{
  "name": "collins-website",
  "version": "0.1.0",
  "private": true,
  "description": "Collins custom pools and backyard portfolio website",
  "scripts": {
    "deploy": "node scripts/bundle-styles.mjs && wrangler deploy",
    "check:deploy": "node scripts/bundle-styles.mjs --check && wrangler deploy --dry-run",
    "build:site": "node scripts/bundle-styles.mjs && node scripts/prepare-static.mjs",
    "build:assets": "node scripts/bundle-styles.mjs"
  },
  "devDependencies": {
    "wrangler": "4.156.2"
  }
}
